# Local development (docker compose up -d provides the services).
# The SAME login user carries different roles per deployable via SET ROLE
# (packages/db) - production uses one login user per deployable instead.
DATABASE_URL=postgres://mio:mio-local-only@localhost:5432/mio     # migrations (owner)
MIO_DATABASE_URL=postgres://mio:mio-local-only@localhost:5432/mio # api/worker pools
MIO_OTP_PEPPER=local-dev-pepper-change-me                          # HMAC pepper for OTP hashing
MIO_COOKIE_SECURE=false                                            # true everywhere except local http
MIO_PUBLIC_BASE_URL=http://localhost:5173                          # links in emails
