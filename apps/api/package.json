{
  "name": "@mio/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Mio API - modular monolith (ADR-0002, ADR-0003)",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mio/authz": "workspace:*",
    "@mio/contracts": "workspace:*",
    "@mio/db": "workspace:*",
    "@mio/schedule": "workspace:*",
    "@mio/survey-schema": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mio/synthetic": "workspace:*",
    "@nestjs/testing": "^11.2.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "unplugin-swc": "^1.5.11"
  }
}
